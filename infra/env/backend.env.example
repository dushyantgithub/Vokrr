# Backend-specific environment example.
# Prefer copying root `.env.example` for full deployments.

TZ=Europe/London
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
BACKEND_CORS_ORIGINS=https://api.vokrr.com
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=replace-with-long-lived-access-token
DEVICE_CONFIG_PATH=/app/config/devices.yaml
COMMAND_CONFIG_PATH=/app/config/commands.yaml
AUTH_DATABASE_PATH=/app/data/auth.db
ONBOARDING_DATABASE_PATH=/app/data/onboarding.db
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
APP_AUTH_SECRET=change-this-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
APP_REGISTRATION_ENABLED=false
APP_REGISTRATION_CODE=
KIOSK_AUTO_LOGIN=true
STATE_SYNC_INTERVAL_SECONDS=5
SPOTIFY_APP_NAME=Vokrr
SPOTIFY_APP_CLIENT_ID=
SPOTIFY_APP_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/spotify/callback
SPOTIFY_TOKEN_PATH=/app/data/spotify_tokens.json
PRIMARY_SSID=
PRIMARY_SSID_PASSWORD=
SECONDARY_SSID=
SECONDARY_SSID_PASSWORD=
WIFI_INTERFACE=wlan0
