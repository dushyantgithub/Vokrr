[Unit]
Description=Configure Vokrr Wi-Fi networks
After=NetworkManager.service
Wants=NetworkManager.service
Before=NetworkManager-wait-online.service network-online.target vokrr-stack.service vokrr-kiosk.service

[Service]
Type=oneshot
Environment=VOKRR_WIFI_SCAN_TIMEOUT_SECONDS=75
ExecStart=/home/dushyant/apps/Vokrr/scripts/configure_wifi_networks.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
