[Unit]
Description=Vokrr Native Qt UI
After=graphical.target sound.target
Wants=graphical.target sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Projects/vokrr
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QUICK_BACKEND=software
ExecStart=/home/pi/Projects/vokrr/scripts/start_vokrr_ui.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
