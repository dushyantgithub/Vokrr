# Vokrr environment template
#
# Copy this file to both `.env` and `scripts/.env` for the standard Docker
# deployment. Keep real secrets out of git.

# General
TZ=Europe/London
LOG_LEVEL=INFO

# Backend
APP_NAME=Vokrr
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
BACKEND_URL=http://localhost:8080
BACKEND_CORS_ORIGINS=https://api.vokrr.com
DEVICE_CONFIG_PATH=/app/config/devices.yaml
COMMAND_CONFIG_PATH=/app/config/commands.yaml
AUTH_DATABASE_PATH=/app/data/auth.db
ONBOARDING_DATABASE_PATH=/app/data/onboarding.db
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
APP_USERNAME=
APP_PASSWORD=
APP_AUTH_SECRET=change-this-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
APP_REGISTRATION_ENABLED=false
APP_REGISTRATION_CODE=
KIOSK_AUTO_LOGIN=true
STATE_SYNC_INTERVAL_SECONDS=5
SYSTEM_RESTART_COMMAND=

# Home Assistant
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=replace-with-long-lived-access-token

# Ultrahuman Ring AIR (server-side only)
UH_TOKEN=
UH_ACCOUNT=
ULTRAHUMAN_TIMEOUT_SECONDS=10
ULTRAHUMAN_MAX_RETRIES=2
ULTRAHUMAN_CACHE_TTL_SECONDS=300

# Network management
PRIMARY_SSID=
PRIMARY_SSID_PASSWORD=
SECONDARY_SSID=
SECONDARY_SSID_PASSWORD=
WIFI_INTERFACE=wlan0
VOKRR_WIFI_IFACE=wlan0
VOKRR_WIFI_SCAN_TIMEOUT_SECONDS=60
VOKRR_WIFI_SCAN_INTERVAL_SECONDS=5

# Public access and generated iOS defaults
IOS_DEFAULT_SERVER_URL=https://api.vokrr.com
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_TOKEN=
DUCK_DNS_TOKEN=
DUCK_DNS_DOMAIN=

# Spotify and Spotify Connect
SPOTIFY_APP_NAME=Vokrr
SPOTIFY_APP_CLIENT_ID=
SPOTIFY_APP_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/spotify/callback
SPOTIFY_TOKEN_PATH=/app/data/spotify_tokens.json

# Kiosk runtime
VOKRR_API_BASE=http://localhost:8080
VOKRR_QT_BIN=/home/dushyant/apps/Vokrr/qt-frontend/build/vokrr-qt
VOKRR_KIOSK_STARTUP_TIMEOUT=180
VOKRR_KIOSK_DISPLAY_TIMEOUT=60
VOKRR_TOUCH_ROTATION=
VOKRR_APP_DIR=/home/dushyant/apps/Vokrr
PI_USER=homeops
XDG_RUNTIME_DIR=/run/user/1000
WAYLAND_DISPLAY=wayland-0
DISPLAY=:0
XAUTHORITY=/home/dushyant/.Xauthority
QT_QPA_PLATFORM=xcb
QT_XCB_NO_XI2=0

# Audio output selection
VOKRR_AUDIO_OUTPUT_ENV=/home/dushyant/apps/Vokrr/backend/data/audio-output.env
VOKRR_AUDIO_FALLBACK_DEVICE=plughw:CARD=MAX98357A,DEV=0
VOKRR_AUDIO_ALLOW_HDMI=0
VOICE_OUTPUT_DEVICE=
VOICE_KEEP_TTS_FILES=0

# Voice listener and wake word
VOICE_BACKEND_URL=http://localhost:8080
VOICE_WAKE_WORD=Jarvis
VOICE_LISTENER_ENABLED=0
VOICE_INPUT_DEVICE=
VOICE_COMMAND_RECORD_SECONDS=10
VOICE_COMMAND_MIN_SECONDS=1.2
VOICE_COMMAND_SILENCE_SECONDS=1.1
VOICE_COMMAND_SILENCE_RMS=450
VOICE_WAKE_COOLDOWN_SECONDS=2.5
VOICE_POST_SPEECH_COOLDOWN_SECONDS=0.8
VOICE_WAKE_MIN_RMS=350
VOICE_WAKE_MIN_PEAK_RMS=650
VOICE_WAKE_RMS_WINDOW_FRAMES=8
VOICE_AUDIO_QUEUE_MAX_CHUNKS=64
VOICE_AUDIO_FRAME_TIMEOUT_SECONDS=5
VOICE_FEEDBACK_ENABLED=1
VOICE_FEEDBACK_WAKE_TEXT=How can I help you sir?
VOICE_FEEDBACK_MISUNDERSTOOD_TEXT=I am afraid sir, but I didnt get you
VOICE_TTS_COMMAND=espeak-ng
VOICE_TTS_RATE=150
VOICE_TTS_FALLBACK_ENABLED=1
VOICE_TTS_FALLBACK_TIMEOUT_SECONDS=8
PORCUPINE_API_KEY=replace-with-picovoice-access-key
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATH=/wake-word/Jarvis_en_raspberry-pi_v4_0_0.ppn
PORCUPINE_SENSITIVITY=0.35
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# NVIDIA LLM and Magpie TTS
VOICE_NVIDIA_PIPELINE_ENABLED=1
NVIDIA_API_KEY=replace-with-nvidia-api-key
NVIDIA_BUILD_API_KEY=
MAGPIE_API_KEY=
NVIDIA_LLM_MODEL=meta/llama-4-maverick-17b-128e-instruct
NVIDIA_LLM_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_LLM_TIMEOUT_SECONDS=20
NVIDIA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
NVIDIA_TTS_GRPC_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_TTS_DEFAULT_VOICE=Magpie-Multilingual.EN-US.Aria
NVIDIA_TTS_LANGUAGE_CODE=en-US
NVIDIA_TTS_SAMPLE_RATE_HZ=44100
VOICE_ENTITY_CACHE_SECONDS=8
VOICE_ROOM_ALIASES=hall:living room|main room|lounge,living room:hall|main room|lounge,bedroom:bed room|master bedroom,gaming room:game room|gaming,dining room:dinning room|dining,kitchen:cook room

# Legacy/simple voice intent bridge
VOICE_INTENT_PORT=8090
MODEL_URL=https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip
MODEL_DIR=/home/dushyant/apps/Vokrr/voice-pipeline/models

# Optional historical deployment values.
# The current codebase does not read these directly. Configure Tuya devices in
# Home Assistant, then import/control the resulting HA entities in Vokrr.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_ENDPOINT=
TUYA_PROJECT_ID=
TUYA_REGION=
TUYA_UID=
TUYA_DEVICE_SOURCE_TYPE=
TUYA_DEVICE_SOURCE_ID=
TUYA_DIRECT_SWITCHBOARD_NAMES=
